# Server Configuration
PORT=4000
DB_URL=your_mongodb_connection_string
SECRET_KEY=your_jwt_secret_key

# Email Configuration (for forgot password functionality)
# Email Configuration (example using Gmail SMTP)
# For Gmail you should create an App Password and use it here (or configure a real SMTP provider)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_smtp_password_or_app_password

# Frontend URL (used to build verification links)
FRONTEND_URL=http://localhost:3000
